PORT=5000
NODE_ENV=development
MONGO_URI=
CLIENT_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Optional — only read by `npm run seed:admin`. If left unset, that
# script falls back to admin@nestro.com / changeme123 for local dev.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional — only read by `npm run seed:catalog`. Free key from
# unsplash.com/developers, used to fetch real product photography.
UNSPLASH_ACCESS_KEY=

# Optional, same pattern as UNSPLASH_ACCESS_KEY above — the server boots
# fine without it, but every email send (welcome, "account already
# exists", password reset OTP) fails until it's set, logged server-side
# and non-blocking rather than failing the request (ADR-062). Free key
# at resend.com. RESEND_FROM defaults to Resend's sandbox address
# (onboarding@resend.dev) if left unset, which can only deliver to the
# Resend account owner's own verified email — real per-user delivery
# needs a verified custom domain (ADR-061, deferred for cost reasons).
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev